# 复制为 .env 后填写

# DeepSeek API Key（https://platform.deepseek.com）
DEEPSEEK_API_KEY=sk-xxxxxxxx

# 系统令牌：首次打开网站时用它创建第一个管理员；也可用于脚本调用（等同管理员）。
# 至少 16 位随机字符，例如：python -c "import secrets;print(secrets.token_urlsafe(32))"
API_TOKEN=

# 登录会话的签名密钥（可选）。不填时自动生成并保存在数据库中。
# SECRET_KEY=

# 本地开发默认 SQLite（data/scout.db）；Docker 中由 docker-compose.yml 指定 Postgres
# DATABASE_URL=postgresql+psycopg://scout:scout@db:5432/scout
# POSTGRES_PASSWORD=scout

# 可选：覆盖 config/settings.yaml 中的值，使用 SECTION__KEY 形式
# CRAWLER__CONCURRENCY=16
# LLM__MODEL=deepseek-flash
